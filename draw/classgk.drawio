        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam class {\n    BackgroundColor #FFF2CC\n    BorderColor #D6B656\n    ArrowColor Black\n}\n\nclass LoaiSuCo {\n  - MaLoai: string\n  - TenLoai: string\n  - MoTa: string\n  - TrangThai: string\n  + ThemLoai(): void\n  + CapNhatLoai(): void\n}\n\nclass TaiKhoan {\n  - MaTaiKhoan: string\n  - TenDangNhap: string\n  - MatKhau: string\n  - HoTen: string\n  - SoDienThoai: string\n  - QuyenHan: string\n  - MaToDoi: string\n  - TrangThai: string\n  + DangNhap(): bool\n  + DoiMatKhau(): void\n  + CapNhatThongTin(): void\n}\n\nclass ToDoi {\n  - MaToDoi: string\n  - TenToDoi: string\n  - MaTruongTo: string\n  - SoDienThoai: string\n  + PhanCongTruongTo(): void\n  + XemThanhVien(): List\n}\n\nclass SuCo {\n  - MaSuCo: string\n  - NgayBaoCao: Datetime\n  - HoTenNguoiBao: string\n  - SoDienThoaiNguoiBao: string\n  - DiaChi: string\n  - MaLoai: string\n  - MoTaChiTiet: string\n  - TrangThai: string\n  - LyDoTuChoi: string\n  - NguoiDuyet: string\n  + TaoMoi(): void\n  + KiemTraHopLe(): bool\n  + DuyetHoSo(): void\n  + TuChoi(): void\n}\n\nclass PhieuPhanCong {\n  - MaPhieu: string\n  - MaSuCo: string\n  - NguoiLap: string\n  - NgayLap: Datetime\n  - MaToDoi: string\n  - MucDoUuTien: string\n  - ThoiHanXuLy: Datetime\n  - GhiChuChiDao: string\n  + LapPhieu(): void\n  + CapNhatTienDo(): void\n}\n\nclass KetQuaXuLy {\n  - MaKetQua: string\n  - MaPhieu: string\n  - NguoiCapNhat: string\n  - NgayGioHoanThanh: Datetime\n  - PhuongAnXuLy: string\n  + CapNhatKetQua(): void\n  + XemChiTiet(): void\n}\n\nclass HinhAnh {\n  - MaHinhAnh: string\n  - DuongDanURL: string\n  - KichThuoc: int\n  - LoaiHinhAnh: string\n  - MaThamChieu: string\n  + TaiAnhLen(): void\n  + XoaAnh(): void\n}\n\nclass ThongBao {\n  - MaThongBao: string\n  - TieuDe: string\n  - NoiDung: string\n  - NguoiNhan: string\n  - ThoiGianTao: Datetime\n  - TrangThai: string\n  + GuiThongBao(): void\n  + DanhDauDaDoc(): void\n}\n\nLoaiSuCo \&quot;1\&quot; -- \&quot;0..*\&quot; SuCo\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; SuCo\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuPhanCong\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; KetQuaXuLy\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; ToDoi\nToDoi \&quot;1\&quot; *-- \&quot;1..*\&quot; TaiKhoan\nToDoi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuPhanCong\nTaiKhoan \&quot;1\&quot; -- \&quot;0..*\&quot; ThongBao\nSuCo \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuPhanCong\nPhieuPhanCong \&quot;1\&quot; -- \&quot;0..1\&quot; KetQuaXuLy\nSuCo \&quot;1\&quot; *-- \&quot;1..*\&quot; HinhAnh\nKetQuaXuLy \&quot;1\&quot; *-- \&quot;1..*\&quot; HinhAnh\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vK63MsAezkpjk8MqIV48-1">

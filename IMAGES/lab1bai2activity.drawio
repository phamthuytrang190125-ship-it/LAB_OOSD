        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName Arial\nskinparam BackgroundColor #FFF3DF\nskinparam swimlane {\n  BorderColor black\n  BorderThickness 1\n  TitleBackgroundColor white\n}\nskinparam activity {\n  BackgroundColor white\n  BorderColor black\n  DiamondBackgroundColor white\n  DiamondBorderColor black\n}\nskinparam ArrowColor black\n\n|Khách hàng|\nstart\n:Yêu cầu mua nước giải khát (NGK);\n\n|Nhân viên cửa hàng|\n:Tiếp nhận yêu cầu mua hàng;\n:Kiểm tra số lượng tồn kho;\n\n|Hệ thống|\n:Truy xuất dữ liệu kho NGK;\n\n|Nhân viên cửa hàng|\nif (Số lượng trong kho?) then (Đủ hàng)\n  :Lập hóa đơn tính tiền;\nelse (Không đủ hàng)\n  if (Loại khách hàng?) then (Khách vãng lai)\n    :Thông báo thiếu hàng / Hủy mua;\n    stop\n  else (Khách quen)\n    :Lập hóa đơn tính tiền ;\n    :Lập phiếu hẹn giao hàng\\n(giao nhiều đợt);\n  endif\nendif\n\n:Thỏa thuận thanh toán;\n\nif (Khách quen yêu cầu trả chậm?) then (Không (Thanh toán ngay))\n  |Khách hàng|\n  :Thanh toán tiền hóa đơn;\n  |Nhân viên cửa hàng|\n  :Thu tiền &amp; Xác nhận;\n  |Hệ thống|\n  :Cập nhật trạng thái thanh toán;\nelse ()\n  |Nhân viên cửa hàng|\n  :Lập phiếu ghi nợ;\n  |Hệ thống|\n  :Lưu thông tin công nợ;\nendif\n\n|Nhân viên cửa hàng|\n:Thực hiện giao hàng\\n(Giao ngay hoặc giao đợt 1 theo hẹn);\n\n|Khách hàng|\n:Nhận đủ hàng NGK;\n\n|Hệ thống|\n:Trừ số lượng tồn kho;\n:Lưu trữ hoàn tất giao dịch;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NJcXRW68O0zWXWS3L40C-1">

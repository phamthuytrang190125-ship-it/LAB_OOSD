        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam class {\n    BackgroundColor #FADADD\n    ArrowColor Black\n    BorderColor Black\n}\nhide circle\n\nclass KhachHang {\n   maKH: string (ID)\n   tenKH: string\n   loaiKhach: string\n  --\n   themKhachHang()\n   capNhatThongTin()\n}\n\nclass PhieuHen {\n   maPhieuHen: string (ID)\n   ngayHenGiao: date\n  --\n   taoPhieuHen()\n}\n\nclass PhieuGhiNo {\n   maPhieuNo: string (ID)\n   ngayLapPhieu: date\n   soTienNo: float\n   ngayDuKienTra: date\n   lyDoNo: string\n  --\n   taoPhieuNo()\n}\n\nclass HoaDon {\n   maHoaDon: string (ID)\n   ngayLap: date\n   tongTien: float\n  --\n   taoHoaDon()\n   tinhTongTien()\n}\n\nclass ChiTietHoaDon {\n   soLuongMua: int\n   thanhTien: float\n}\n\nclass NhanHieu {\n   maLoai: string (ID)\n   tenLoai: string\n  --\n   themNhanHieu()\n   capNhatNhanHieu()\n}\n\nclass NuocGiaiKhat {\n   maNGK: string (ID)\n   tenNGK: string\n   donViTinh: string\n   soLuongTon: int\n  --\n   kiemTraSoLuongTonKho()\n   capNhatThongTin()\n}\n\nclass NhanVien {\n   maNV: string (ID)\n   tenNV: string\n  --\n   lapDonDatHang()\n   lapHoaDon()\n   lapPhieuGhiNo()\n}\n\nclass DonDatHang {\n   maDDH: string (ID)\n   ngayDatHang: date\n   ngayNhanHang: date\n  --\n   taoDonDatHang()\n}\n\nclass ChiTietDonDatHang {\n   soLuongDat: int\n}\n\nclass NhaCungUng {\n   maNCU: string (ID)\n   tenNCU: string\n   diaChi: string\n   soDienThoai: string\n  --\n   themNCU()\n   capNhatThongTin()\n}\n\nclass PhieuGiaoHang {\n   maPhieuGiao: string (ID)\n   ngayGiao: date\n   soTienPhaiTra: float\n   dotGiaoHang: int\n  --\n   taoPhieuGiao()\n   tinhTienPhaiTra()\n}\n\nclass ChiTietPhieuGiao {\n   soLuongGiao: int\n   donGia: float\n}\n\n&#39; --- Các mối quan hệ (Associations &amp; Multiplicities) ---\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHen\n\nHoaDon \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHoaDon\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHoaDon\n\nNhanHieu \&quot;1\&quot; -- \&quot;1..*\&quot; NuocGiaiKhat\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\n\nDonDatHang \&quot;1\&quot; -- \&quot;1..3\&quot; PhieuGiaoHang\nDonDatHang \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietDonDatHang\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietDonDatHang\n\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaoHang\n\nPhieuGiaoHang \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuGiao\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuGiao\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CP5AVFVBYff9v_8YtAYl-1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\nskinparam linetype ortho\nskinparam DefaultFontName Arial\nskinparam class {\n    BackgroundColor #FFF2CC\n    HeaderBackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n}\n\nentity \&quot;TheLoai\&quot; as TheLoai {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaTheLoai&lt;/u&gt; : varchar2(20)\n  --\n  TenTheLoai : varchar2(100)\n}\n\nentity \&quot;NhaXuatBan\&quot; as NhaXuatBan {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhaXuatBan&lt;/u&gt; : varchar2(20)\n  --\n  DiaChi : varchar2(255)\n  SoDienThoai : varchar2(20)\n}\n\nentity \&quot;DauSach\&quot; as DauSach {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDauSach&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaTheLoai&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhaXuatBan&lt;/u&gt; : varchar2(20)\n  --\n  TenSach : varchar2(200)\n  NamXuatBan : int\n  SoLuongHienCo : int\n}\n\nentity \&quot;DocGia\&quot; as DocGia {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDocGia&lt;/u&gt; : varchar2(20)\n  --\n  Ho : varchar2(50)\n  Ten : varchar2(50)\n  NgaySinh : date\n  Phai : varchar2(10)\n  SoDienThoai : varchar2(20)\n  DiaChi : varchar2(255)\n  Email : varchar2(100)\n  Anh3x4 : varchar2(255)\n}\n\nentity \&quot;TheDocGia\&quot; as TheDocGia {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaThe&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDocGia&lt;/u&gt; : varchar2(20)\n  --\n  NgayCap : date\n  HanSuDung : date\n  DaDongLePhi : bit\n  TrangThai : bit\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhanVien&lt;/u&gt; : varchar2(20)\n  --\n  Ho : varchar2(50)\n  Ten : varchar2(50)\n  Phai : varchar2(10)\n  NgaySinh : date\n  ChucVu : varchar2(50)\n  SoDienThoai : varchar2(20)\n}\n\nentity \&quot;PhieuMuon\&quot; as PhieuMuon {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaPhieuMuon&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDocGia&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhanVien&lt;/u&gt; : varchar2(20)\n  --\n  NgayMuon : date\n  NgayHenTra : date\n}\n\nentity \&quot;ChiTietPhieuMuon\&quot; as ChiTietPhieuMuon {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaChiTiet&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaPhieuMuon&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDauSach&lt;/u&gt; : varchar2(20)\n  --\n  NgayTraThucTe : date\n  TinhTrangTra : varchar2(100)\n}\n\nentity \&quot;PhieuPhat\&quot; as PhieuPhat {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaPhieuPhat&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaChiTiet&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhanVien&lt;/u&gt; : varchar2(20)\n  --\n  NgayPhat : date\n  LyDo : varchar2(255)\n  PhiPhat : decimal(18,2)\n}\n\n&#39; ==========================================\n&#39; Mối quan hệ và định tuyến vị trí\n&#39; ==========================================\n\nTheLoai ||-down-o{ DauSach\nNhaXuatBan ||-down-o{ DauSach\n\nDauSach ||-right-o{ ChiTietPhieuMuon\nPhieuMuon ||-down-o{ ChiTietPhieuMuon\n\nDocGia ||-right-o| TheDocGia\nDocGia ||-down-o{ PhieuMuon\n\nNhanVien ||-down-o{ PhieuMuon\nNhanVien ||-down-o{ PhieuPhat\n\nChiTietPhieuMuon ||-down-o| PhieuPhat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9guCy1ONi9aoHPed6NZW-1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\nskinparam linetype ortho\nskinparam classBackgroundColor #FFF2CC\nskinparam classBorderColor #A63A50\nskinparam classArrowColor #A63A50\nskinparam DefaultFontName Arial\n\nentity \&quot;NhomSanPham\&quot; as NhomSanPham {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhom&lt;/u&gt; : varchar2(20)\n  --\n  TenNhom : varchar2(100)\n}\n\nentity \&quot;SanPham\&quot; as SanPham {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaSP&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNhom&lt;/u&gt; : varchar2(20)\n  --\n  TenSP : varchar2(200)\n  NhaSanXuat : varchar2(100)\n  HinhAnh : varchar2(255)\n  MoTa : clob\n  ThongSoKyThuat : clob\n  GiaBan : number(18,2)\n  TinhTrang : varchar2(50)\n}\n\nentity \&quot;KhachHang\&quot; as KhachHang {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaKH&lt;/u&gt; : varchar2(20)\n  --\n  HoTen : varchar2(100)\n  NgaySinh : date\n  CMND_Passport : varchar2(20)\n  DiaChi : varchar2(255)\n  DienThoai : varchar2(20)\n  TenDangNhap : varchar2(50)\n  MatKhau : varchar2(100)\n  Email : varchar2(100)\n}\n\nentity \&quot;GioHang\&quot; as GioHang {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaGioHang&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaKH&lt;/u&gt; : varchar2(20)\n}\n\nentity \&quot;DonHang\&quot; as DonHang {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;SoDDH&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaKH&lt;/u&gt; : varchar2(20)\n  --\n  HoTenNguoiNhan : varchar2(100)\n  DiaChiNguoiNhan : varchar2(255)\n  DienThoaiNguoiNhan : varchar2(20)\n  LoaiPhieuDat : varchar2(50)\n  PhiGiaoHang : number(18,2)\n  TongTien : number(18,2)\n  ThoiDiemDat : timestamp\n}\n\nentity \&quot;ChiTietGioHang\&quot; as ChiTietGioHang {\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaGioHang&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaSP&lt;/u&gt; : varchar2(20)\n  --\n  SoLuong : number(10)\n}\n\nentity \&quot;ChiTietDonHang\&quot; as ChiTietDonHang {\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;SoDDH&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaSP&lt;/u&gt; : varchar2(20)\n  --\n  SoLuong : number(10)\n  DonGia : number(18,2)\n}\n\nentity \&quot;TheTinDung\&quot; as TheTinDung {\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;SoDDH&lt;/u&gt; : varchar2(20)\n  --\n  SoThe : varchar2(20)\n  LoaiThe : varchar2(50)\n  NgayHetHan : date\n  HoTenChuThe : varchar2(100)\n  MaCSV : varchar2(4)\n}\n\n&#39; ==========================================\n&#39; Định tuyến vị trí và nối bảng vuông góc\n&#39; ==========================================\n\nNhomSanPham ||-down-o{ SanPham\nKhachHang ||-down-o| GioHang\nKhachHang ||-down-o{ DonHang\n\nGioHang ||-down-o{ ChiTietGioHang\nSanPham ||-down-o{ ChiTietGioHang\n\nDonHang ||-down-o{ ChiTietDonHang\nSanPham ||-right-o{ ChiTietDonHang\n\nDonHang ||-down-o| TheTinDung\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jrU_tlB0yxdq-j3CG1-r-1">

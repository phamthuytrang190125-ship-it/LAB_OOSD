        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\nskinparam classBackgroundColor #FFF2CC\nskinparam classBorderColor #A63A50\nskinparam classArrowColor #A63A50\nskinparam DefaultFontName Arial\n\nentity \&quot;NhaCungUng\&quot; as NhaCungUng {\n  &lt;color:red&gt;&lt;b&gt;PK MaNCU : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  TenNCU : nvarchar(100)\n  DiaChi : nvarchar(200)\n  DienThoai : varchar(15)\n}\n\nentity \&quot;LoaiNGK\&quot; as LoaiNGK {\n  &lt;color:red&gt;&lt;b&gt;PK MaLoai : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaNCU : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  TenLoai : nvarchar(100)\n}\n\nentity \&quot;NuocGiaiKhat\&quot; as NuocGiaiKhat {\n  &lt;color:red&gt;&lt;b&gt;PK MaNGK : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaLoai : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  TenNGK : nvarchar(100)\n  DonViTinh : nvarchar(20)\n  SoLuongTon : int\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  &lt;color:red&gt;&lt;b&gt;PK MaNV : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  TenNV : nvarchar(100)\n}\n\nentity \&quot;KhachHang\&quot; as KhachHang {\n  &lt;color:red&gt;&lt;b&gt;PK MaKH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  TenKH : nvarchar(100)\n  LoaiKhach : nvarchar(50)\n}\n\nentity \&quot;DonDatHang\&quot; as DonDatHang {\n  &lt;color:red&gt;&lt;b&gt;PK SoDDH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaNCU : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaNV : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  NgayDat : date\n  NgayNhan : date\n}\n\nentity \&quot;ChiTietDDH\&quot; as ChiTietDDH {\n  &lt;color:red&gt;&lt;b&gt;PK SoDDH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;PK MaNGK : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  SoLuongDat : int\n}\n\nentity \&quot;PhieuGiaoHang\&quot; as PhieuGiaoHang {\n  &lt;color:red&gt;&lt;b&gt;PK SoPGH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK SoDDH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  NgayGiao : date\n  TongTien : number(18,2)\n}\n\nentity \&quot;ChiTietPGH\&quot; as ChiTietPGH {\n  &lt;color:red&gt;&lt;b&gt;PK SoPGH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;PK MaNGK : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  SoLuongGiao : int\n  SoTien : number(18,2)\n}\n\nentity \&quot;HoaDon\&quot; as HoaDon {\n  &lt;color:red&gt;&lt;b&gt;PK SoHD : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaKH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaNV : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  NgayLap : date\n  TongTien : number(18,2)\n}\n\nentity \&quot;ChiTietHoaDon\&quot; as ChiTietHoaDon {\n  &lt;color:red&gt;&lt;b&gt;PK SoHD : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;PK MaNGK : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  SoLuong : int\n  DonGia : number(18,2)\n}\n\nentity \&quot;PhieuHen\&quot; as PhieuHen {\n  &lt;color:red&gt;&lt;b&gt;PK SoPhieuHen : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK SoHD : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  NgayHen : date\n}\n\nentity \&quot;ChiTietPhieuHen\&quot; as ChiTietPhieuHen {\n  &lt;color:red&gt;&lt;b&gt;PK SoPhieuHen : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;PK MaNGK : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  SoLuongHen : int\n}\n\nentity \&quot;PhieuGhiNo\&quot; as PhieuGhiNo {\n  &lt;color:red&gt;&lt;b&gt;PK SoPhieuNo : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaKH : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  &lt;color:red&gt;&lt;b&gt;FK MaNV : varchar(10)&lt;/b&gt;&lt;/color&gt;\n  --\n  NgayLap : date\n  SoTienNo : number(18,2)\n  NgayDuKienTra : date\n  LyDo : nvarchar(255)\n}\n\n&#39; Liên kết Nhập hàng\nNhaCungUng ||--o{ LoaiNGK\nNhaCungUng ||--o{ DonDatHang\nLoaiNGK ||--o{ NuocGiaiKhat\n\nDonDatHang ||--o{ ChiTietDDH\nNuocGiaiKhat ||--o{ ChiTietDDH\n\nDonDatHang ||--o{ PhieuGiaoHang\nPhieuGiaoHang ||--o{ ChiTietPGH\nNuocGiaiKhat ||--o{ ChiTietPGH\n\n&#39; Liên kết Bán hàng &amp; Công nợ\nKhachHang ||--o{ HoaDon\nKhachHang ||--o{ PhieuGhiNo\n\nHoaDon ||--o{ ChiTietHoaDon\nNuocGiaiKhat ||--o{ ChiTietHoaDon\n\nHoaDon ||--o{ PhieuHen\nPhieuHen ||--o{ ChiTietPhieuHen\nNuocGiaiKhat ||--o{ ChiTietPhieuHen\n\n&#39; Liên kết Nhân viên\nNhanVien ||--o{ DonDatHang\nNhanVien ||--o{ HoaDon\nNhanVien ||--o{ PhieuGhiNo\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6iJSDPfx9HyTjSfp-6qX-1">

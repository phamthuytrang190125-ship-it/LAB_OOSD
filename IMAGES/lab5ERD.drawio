        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\nskinparam linetype ortho\nskinparam classBackgroundColor #FFF2CC\nskinparam classBorderColor #A63A50\nskinparam classArrowColor #A63A50\nskinparam DefaultFontName Arial\n\nentity \&quot;DiemThamQuan\&quot; as DiemThamQuan {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDiemTQ&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaTour : varchar2(20)\n  --\n  TenDiemThamQuan : varchar2(200)\n  DiaDiem : varchar2(200)\n  NoiDung : varchar2(500)\n  YNghia : varchar2(500)\n}\n\nentity \&quot;Tour\&quot; as Tour {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaTour&lt;/u&gt; : varchar2(20)\n  --\n  TenTour : varchar2(200)\n  SoNgay : int\n  SoDem : int\n  DonGiaKhach : decimal(18,2)\n}\n\nentity \&quot;PhuongTien\&quot; as PhuongTien {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaPT&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaTour : varchar2(20)\n  --\n  LoaiPhuongTien : varchar2(100)\n}\n\nentity \&quot;DiemDungChan\&quot; as DiemDungChan {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaDiemDung&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaTour : varchar2(20)\n  --\n  TenDiem : varchar2(200)\n  CoDoiPhuongTien : bit\n  CoNoiAn : bit\n  CoKhachSan : bit\n  LoaiKhachSan : int\n}\n\nentity \&quot;ChuyenDi\&quot; as ChuyenDi {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaChuyen&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaTour : varchar2(20)\n  --\n  NgayDi : date\n  NgayVe : date\n}\n\nentity \&quot;KhachHang\&quot; as KhachHang {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaKH&lt;/u&gt; : varchar2(20)\n  --\n  TenKH : varchar2(100)\n  DienThoai : varchar2(20)\n  DiaChi : varchar2(200)\n  LoaiKhach : varchar2(50)\n  TenCoQuan : varchar2(150)\n  NguoiDaiDien : varchar2(100)\n}\n\nentity \&quot;NhanVien\&quot; as NhanVien {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNV&lt;/u&gt; : varchar2(20)\n  --\n  HoTen : varchar2(100)\n  DienThoai : varchar2(20)\n  LuongCanBan : decimal(18,2)\n}\n\nentity \&quot;PhanCongHDV\&quot; as PhanCongHDV {\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaNV&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;PK, FK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaChuyen&lt;/u&gt; : varchar2(20)\n  --\n  NgayPhanCong : date\n}\n\nentity \&quot;PhieuDangKy\&quot; as PhieuDangKy {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaPhieu&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaKH : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaChuyen : varchar2(20)\n  --\n  NgayLap : date\n  SoNguoiDi : int\n  DiaDiemDon : varchar2(200)\n  DaDatCoc : decimal(18,2)\n  TongTien : decimal(18,2)\n  TrangThaiThanhToan : varchar2(50)\n}\n\nentity \&quot;PhieuKhaoSat\&quot; as PhieuKhaoSat {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaKhaoSat&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaPhieu : varchar2(20)\n  --\n  NgayGui : date\n  NoiDungGopY : clob\n}\n\nentity \&quot;HanhKhach\&quot; as HanhKhach {\n  &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; &lt;u&gt;MaHanhKhach&lt;/u&gt; : varchar2(20)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaPhieu : varchar2(20)\n  --\n  HoTen : varchar2(100)\n  CMND_CCCD : varchar2(20)\n}\n\n&#39; ==========================================\n&#39; Định tuyến vị trí và nối bảng vuông góc\n&#39; ==========================================\n\nTour ||-left-o{ DiemThamQuan\nTour ||-right-o{ PhuongTien\nTour ||-down-o{ DiemDungChan\nTour ||-down-o{ ChuyenDi\n\n&#39; Căn chỉnh các bảng không có liên kết trực tiếp thẳng hàng\nDiemThamQuan -[hidden]down-&gt; DiemDungChan\nPhuongTien -[hidden]down-&gt; KhachHang\n\nChuyenDi ||-down-o{ PhieuDangKy\nKhachHang ||-down-o{ PhieuDangKy\n\nNhanVien ||-right-o{ PhanCongHDV\nChuyenDi ||-down-o{ PhanCongHDV\n\nPhieuDangKy ||-right-o{ PhieuKhaoSat\nPhieuDangKy ||-right-o{ HanhKhach\n\nPhieuKhaoSat -[hidden]down-&gt; HanhKhach\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6M0Fr3QUAevxWhKfNGAK-1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam class {\n    HeaderBackgroundColor #FADADD\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n}\nskinparam defaultFontName Arial\nhide circle\n\nclass TheLoai {\n   MaTheLoai: string\n   TenTheLoai: string\n  --\n   themTheLoai()\n   capNhatTheLoai()\n}\n\nclass DauSach {\n   MaDauSach: string\n   TenSach: string\n   NamXuatBan: int\n   SoLuongHienCo: int\n   MaTheLoai: string\n   MaNhaXuatBan: string\n  --\n   themDauSach()\n   capNhatSoLuong()\n   kiemTraTonKho(): bool\n}\n\nclass NhaXuatBan {\n   MaNhaXuatBan: string\n   DiaChi: string\n   SoDienThoai: string\n  --\n   themNXB()\n   capNhatThongTinNXB()\n}\n\nclass ChiTietPhieuMuon {\n   MaChiTiet: string\n   MaPhieuMuon: string\n   MaDauSach: string\n   NgayTraThucTe: \n   TinhTrangTra: string\n  --\n   themChiTiet()\n   traSach()\n   capNhatTinhTrang()\n}\n\nclass TheDocGia {\n   MaThe: string\n   MaDocGia: string\n   NgayCap: DateTime\n   HanSuDung: DateTime\n   DaDongLePhi: bool\n   TrangThai: bool\n  --\n   capTheMoi()\n   giaHanThe()\n   kiemTraHopLe(): bool\n}\n\nclass PhieuPhat {\n   MaPhieuPhat: string\n   MaChiTiet: string\n   MaNhanVien: string\n   NgayPhat: DateTime\n   LyDo: string\n   PhiPhat: decimal\n  --\n   lapPhieuPhat()\n   tinhTienPhat()\n   thanhToanPhat()\n}\n\nclass NhanVien {\n   MaNhanVien: string\n   Ho: string\n   Ten: string\n   Phai: string\n   NgaySinh: DateTime\n   ChucVu: string\n   SoDienThoai: string\n  --\n   themNhanVien()\n   capNhatThongTin()\n   xoaNhanVien()\n}\n\nclass PhieuMuon {\n   MaPhieuMuon: string\n   MaDocGia: string\n   MaNhanVien: string\n   NgayMuon: DateTime\n   NgayHenTra: DateTime\n  --\n   lapPhieuMuon()\n   xacNhanMuon()\n}\n\nclass DocGia {\n   MaDocGia: string\n   Ho: string\n   Ten: string\n   NgaySinh: \n   Phai: string\n   SoDienThoai: string\n   DiaChi: string\n   Email: string\n   Anh3x4: string\n  --\n   dangKyDocGia()\n   capNhatThongTin()\n}\n\n&#39; --- Các mối quan hệ và bản số (Multiplicities) ---\n\nTheLoai \&quot;1\&quot; -- \&quot;0..*\&quot; DauSach\nNhaXuatBan \&quot;1\&quot; -- \&quot;0..*\&quot; DauSach\n\nDauSach \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuMuon\nPhieuMuon \&quot;1\&quot; -- \&quot;1..3\&quot; ChiTietPhieuMuon\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuMuon\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuPhat\nPhieuPhat \&quot;0..1\&quot; -- \&quot;1\&quot; ChiTietPhieuMuon\n\nDocGia \&quot;1\&quot; -- \&quot;0..*\&quot; TheDocGia\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9guCy1ONi9aoHPed6NZW-1">

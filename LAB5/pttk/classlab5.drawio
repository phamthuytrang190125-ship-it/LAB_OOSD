        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam class {\n    BackgroundColor #FFF2CC\n    BorderColor #D6B656\n    ArrowColor Black\n}\n\nclass KhachHang {\n   MaKH: string\n   TenKH: string\n   DienThoai: string\n   DiaChi: string\n   DangKyTour(): void\n   ThanhToan(): void\n   LamKhaoSat(): void\n}\n\nclass KhachDoan {\n   TenCoQuan: string\n   NguoiDaiDien: string\n   SoNguoiDi: int\n   DiaDiemDon: string\n   DaDatCoc: decimal\n   ThanhToanTienCoc(): void\n   ThanhToanKinhPhiThamQuan(): void\n   CungCapDanhSachBaoHiem(): void\n}\n\nclass KhachLe {\n   DiemBanVe: string\n   SoNguoiDi: int\n   ThanhToanTienVe(): void\n}\n\nclass HanhKhach {\n   MaHanhKhach: string\n   HoTen: string\n   CMND_CCCD: string\n   ThemHanhKhach(): void\n   XoaHanhKhach(): void\n}\n\nclass Tour {\n   MaTour: string\n   TenTour: string\n   SoNgay: int\n   SoDem: int\n   DonGiaKhach: decimal\n   ThemTour(): void\n   CapNhatTour(): void\n   TinhTongGia(): decimal\n}\n\nclass ChuyenDi {\n   MaChuyen: string\n   NgayDi: Datetime\n   NgayVe: Datetime\n   TaoChuyenDi(): void\n   CapNhatLich(): void\n   PhanCongNhanVien(): void\n}\n\nclass PhieuDangKy {\n   MaPhieu: string\n   NgayLap: Datetime\n   TongTien: decimal\n   TrangThaiThanhToan: string\n   LapPhieu(): void\n   HuyPhieu(): void\n   CapNhatTrangThai(): void\n}\n\nclass NhanVien {\n   MaNV: string\n   HoTen: string\n   DienThoai: string\n   LuongCanBan: decimal\n   TinhLuong(): decimal\n   NhanLichPhanCong(): void\n}\n\nclass DiemDungChan {\n   MaDiemDung: string\n   TenDiem: string\n   CoDoiPhuongTien: bool\n   CoNoiAn: bool\n   CoKhachSan: bool\n   LoaiKhachSan: int\n   CapNhatThongTin(): void\n}\n\nclass DiemThamQuan {\n   MaDiemTQ: string\n   TenDiemThamQuan: string\n   DiaDiem: string\n   NoiDung: string\n   YNghia: string\n   XemThongTin(): void\n   CapNhatDiemThamQuan(): void\n}\n\nclass PhuongTien {\n   MaPT: string\n   LoaiPhuongTien: string\n   CapNhatPhuongTien(): void\n}\n\nclass PhieuKhaoSat {\n  - MaKhaoSat: string\n  - NgayGui: Datetime\n  - NoiDungGopY: string\n  + GuiPhieu(): void\n  + GhiNhanGopY(): void\n}\n\n&#39; === MỐI QUAN HỆ KẾ THỪA ===\nKhachHang &lt;|-- KhachDoan\nKhachHang &lt;|-- KhachLe\n\n&#39; === MỐI QUAN HỆ TẬP HỢP &amp; LIÊN KẾT ===\nKhachDoan \&quot;1\&quot; o-- \&quot;0..*\&quot; HanhKhach\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; ChuyenDi\nTour \&quot;1\&quot; o-- \&quot;1..*\&quot; DiemDungChan\nKhachHang \&quot;1\&quot; -- \&quot;1..*\&quot; PhieuDangKy\nPhieuDangKy \&quot;1..*\&quot; -- \&quot;1\&quot; ChuyenDi\nNhanVien \&quot;1..*\&quot; -- \&quot;0..*\&quot; ChuyenDi\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhaoSat\nTour \&quot;1\&quot; -- \&quot;1..*\&quot; PhuongTien\nTour \&quot;1\&quot; -- \&quot;1..*\&quot; DiemThamQuan\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2VEws81RRmduwK9GzIha-122">
